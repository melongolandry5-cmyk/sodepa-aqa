# ---- Cibles ----
# API : backend Spring Boot. Environnement de test partage par defaut ;
# mettre http://localhost:8082 pour viser un backend lance en local.
API_BASE_URL=https://test.secou.cm
# UI : front de l'ERP (adapter au port reel une fois le front disponible)
UI_BASE_URL=http://localhost:4200

# ---- Comptes de test (Keycloak realm "sodepa") ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=DefaultPassword123!
COMPTABLE_USERNAME=comptable
COMPTABLE_PASSWORD=DefaultPassword123!

# ---- Execution ----
HEADLESS=true
API_TIMEOUT_MS=30000
# true pour autoriser les tests destructifs (cloture d'exercice, suppressions,
# changement de mot de passe). A n'activer que sur un environnement jetable.
RUN_DESTRUCTIVE=false

# ---- Adherence au depot backend (facultative) ----
# Seule reference au code du backend dans tout le depot AQA : chemin vers ses
# sources Java, utilise par le garde-fou de couverture
# (api/system_core/tests/surface.spec.ts). Chemin relatif a la racine du depot
# AQA ou absolu. Laisser vide en CI si le backend n'est pas clone : le
# garde-fou se met alors en skip.
BACKEND_SOURCE_PATH=../sodepa_backend/src/main/java

# Journalisation verbeuse du socle (helpers/logger.ts)
DEBUG_AQA=false
