# ---- Cibles ----
# API : backend Spring Boot. Environnement de test partage par defaut ;
# mettre http://localhost:8082 pour viser un backend lance en local.
API_BASE_URL=https://test.secou.cm
# UI : front de l'ERP (adapter au port reel une fois le front disponible)
UI_BASE_URL=http://localhost:4200

# ---- Comptes de test (Keycloak realm "sodepa") ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=DefaultPassword123!
COMPTABLE_USERNAME=comptable
COMPTABLE_PASSWORD=DefaultPassword123!

# ---- Execution ----
HEADLESS=true
API_TIMEOUT_MS=30000
# true pour autoriser les tests destructifs (cloture d'exercice, suppressions,
# changement de mot de passe). A n'activer que sur un environnement jetable.
RUN_DESTRUCTIVE=false

# ---- Adherence au depot backend (facultative) ----
# Seule reference au code du backend dans tout le depot AQA : chemin vers ses
# sources Java, utilise par le garde-fou de couverture
# (api/system_core/tests/surface.spec.ts). Chemin relatif a la racine du depot
# AQA ou absolu. Laisser vide en CI si le backend n'est pas clone : le
# garde-fou se met alors en skip.
BACKEND_SOURCE_PATH=../sodepa_backend/src/main/java

# Journalisation verbeuse du socle (helpers/logger.ts)
DEBUG_AQA=false

# ---- Squash TM (gestion des tests) ----
# Squash tourne sous le contexte servlet /squash : l'API est donc sous
# <host>/squash/api/rest/latest.
SQUASH_URL=http://localhost:8090/squash/api/rest/latest
SQUASH_USER=admin
# Squash TM 15 REFUSE le mot de passe sur l'API (401 « Basic authentication is
# not allowed for REST API »). Il faut un jeton personnel, envoye en en-tete
# Bearer : menu du compte en haut a droite > ton compte > rubrique des jetons
# d'API. Le jeton n'est affiche qu'une seule fois, a sa creation.
SQUASH_TOKEN=
SQUASH_PASSWORD=
# Nom exact du projet Squash, et dossier racine cree sous "Cas de test"
SQUASH_PROJECT=erp sodepa
SQUASH_ROOT_FOLDER=Playwright API
# Projet Playwright a inventorier
SQUASH_PW_PROJECT=api
# Valeurs metier des cas crees
SQUASH_IMPORTANCE=MEDIUM
SQUASH_STATUS=WORK_IN_PROGRESS
# Codes de nature / type : laisser vide pour garder les defauts du projet.
# Un code absent de la liste personnalisee provoquerait un HTTP 400.
SQUASH_NATURE=
SQUASH_TYPE=
# Champs d'automatisation : auto (essaie puis se replie), off (ne les envoie pas)
SQUASH_AUTOMATION_FIELDS=auto
SQUASH_AUTOMATED_TECHNOLOGY=Playwright
